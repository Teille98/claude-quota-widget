<?xml version="1.0" encoding="utf-8"?>
<!-- 5×2 widget: same header as the 4×2, then session, week and model in three columns. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Claude" android:textColor="@color/text" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/age" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/muted" android:textSize="11sp" />
        <ImageButton android:id="@+id/refresh" android:layout_width="44dp" android:layout_height="44dp"
            android:background="@android:color/transparent" android:src="@drawable/ic_refresh"
            android:contentDescription="@string/btn_refresh" />
    </LinearLayout>
    <TextView android:id="@+id/banner" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingEnd="10dp" android:textColor="@color/muted" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:paddingEnd="10dp">
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            android:orientation="vertical">
            <TextView android:id="@+id/label1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="12sp" />
            <TextView android:id="@+id/value1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/normal" android:textSize="22sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/bar1" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp"
                android:max="100" android:progressDrawable="@drawable/bar" />
            <TextView android:id="@+id/reset1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="2" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="14dp"
            android:orientation="vertical">
            <TextView android:id="@+id/label2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="12sp" />
            <TextView android:id="@+id/value2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/normal" android:textSize="22sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/bar2" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp"
                android:max="100" android:progressDrawable="@drawable/bar" />
            <TextView android:id="@+id/reset2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="2" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="0dp"
            android:orientation="vertical">
            <TextView android:id="@+id/label3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:textColor="@color/text" android:textSize="12sp" />
            <TextView android:id="@+id/value3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/normal" android:textSize="22sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/bar3" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="2dp"
                android:max="100" android:progressDrawable="@drawable/bar" />
            <TextView android:id="@+id/reset3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:maxLines="2" android:textColor="@color/muted" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
