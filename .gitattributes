# Normalize line endings (LF in the repo), except scripts that need their own.
* text=auto
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.iss   text eol=crlf
*.sln   text eol=crlf
gradlew text eol=lf
*.sh    text eol=lf

# Binaries
*.png  binary
*.ico  binary
*.jar  binary
*.jks  binary
